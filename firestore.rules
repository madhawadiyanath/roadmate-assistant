rules_version = '2';
// RoadMate Firestore rules — role is stored at users/{uid}.role
// ("driver" or "mechanic"). Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role in ['driver', 'mechanic'];
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role in ['driver', 'mechanic'];
      allow delete: if false;

      // ---- Per-user data (Vehicle / Contacts / Notifications module) ----

      // Saved vehicles: the owner has full control.
      match /vehicles/{vehicleId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.make is string
          && request.resource.data.model is string
          && request.resource.data.plateNo is string
          && request.resource.data.plateNo.size() > 0
          && request.resource.data.year is int;
      }

      // Emergency contacts: the owner has full control.
      match /emergencyContacts/{contactId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.phone is string
          && request.resource.data.phone.size() > 0;
      }

      // Notifications: only the owner reads them and may flip `read`.
      // Any signed-in user may *create* one for someone else (e.g. a mechanic
      // notifying the driver), but must stamp their own uid as senderUid and
      // can only create it unread.
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.read == false;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);
      }
    }

    // Assistance requests.
    // - Driver creates own request as pending.
    // - Any logged-in mechanic sees pending requests (new jobs feed).
    // - Mechanic claims a pending job (accept), then advances its status.
    // - Driver reads own requests and may cancel them.
    match /requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null
        && (resource.data.driverUid == request.auth.uid
          || resource.data.mechanicUid == request.auth.uid
          || resource.data.status == 'pending');
      allow update: if request.auth != null
        && (
          // Driver cancels own request.
          (resource.data.driverUid == request.auth.uid
            && request.resource.data.status == 'cancelled')
          // Mechanic claims a pending job.
          || (resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.mechanicUid == request.auth.uid)
          // Assigned mechanic advances the job.
          || (resource.data.mechanicUid == request.auth.uid
            && request.resource.data.mechanicUid == request.auth.uid
            && request.resource.data.status
              in ['accepted', 'onTheWay', 'completed'])
        );
      allow delete: if false;
    }
  }
}
