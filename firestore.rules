rules_version = '2';
// RoadMate Firestore rules — role is stored at users/{uid}.role
// ("driver", "mechanic", or console-created "admin").
// Admins can ONLY be made in the Firebase console: the create rule below
// rejects role == 'admin', so the app can never self-promote anyone.
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Own role lookup. Short-circuit (`||` first) keeps own-doc reads
    // free of extra get() charges.
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // App sign-up: driver/mechanic only. Admins come from the console.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['driver', 'mechanic'];
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['driver', 'mechanic'];
      allow delete: if false;

      // Saved vehicles (the driver's garage). Owner only.
      match /vehicles/{vehicleId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.make is string
          && request.resource.data.model is string
          && request.resource.data.plateNo is string
          && request.resource.data.plateNo.size() > 0
          && request.resource.data.year is int;
      }

      // Emergency contacts. Owner only.
      match /emergencyContacts/{contactId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.phone is string
          && request.resource.data.phone.size() > 0;
      }

      // Inbox. Anyone signed in may drop a notification into it (stamped
      // with their own uid, unread); only the owner reads, marks read
      // (the `read` field is the only editable one) or deletes.
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.read == false;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);
      }

      // Saved payment methods — owner only (metadata, never full PANs).
      match /paymentMethods/{methodId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Money movements. Payer creates on submit; payee collects cash;
    // admin oversees. Parties + admin may read.
    match /transactions/{txnId} {
      allow create: if signedIn()
        && request.resource.data.payerUid == request.auth.uid
        && request.resource.data.status in ['paid', 'pending'];
      allow read: if signedIn()
        && (resource.data.payerUid == request.auth.uid
          || resource.data.payeeUid == request.auth.uid
          || isAdmin());
      allow update: if signedIn()
        && (resource.data.payeeUid == request.auth.uid
          || isAdmin());
      allow delete: if false;
    }

    // Assistance requests.
    // - Driver creates own request as pending.
    // - Any logged-in mechanic sees pending requests (new jobs feed).
    // - Mechanic claims a pending job (accept), then advances its status.
    // - Driver reads own requests and may cancel them.
    match /requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (resource.data.driverUid == request.auth.uid
          || resource.data.mechanicUid == request.auth.uid
          || resource.data.status == 'pending'
          || isAdmin());
      allow update: if signedIn()
        && (
          // Driver cancels own request.
          (resource.data.driverUid == request.auth.uid
            && request.resource.data.status == 'cancelled')
          // Driver edits pickup details of their own pending request
          // (address only — status/type/assignment stay untouched).
          || (resource.data.driverUid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['address']))
          // Mechanic claims a pending job.
          || (resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.mechanicUid == request.auth.uid)
          // Driver rates their own completed request, once; nothing else
          // on the doc may change.
          || (resource.data.driverUid == request.auth.uid
            && resource.data.status == 'completed'
            && !('ratedAt' in resource.data)
            && request.resource.data.rating is int
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5
            && request.resource.data.feedback is string
            && request.resource.data.feedback.size() <= 1000
            && request.resource.data.tags is list
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['rating', 'feedback', 'tags', 'ratedAt']))
          // Assigned mechanic advances the job.
          || (resource.data.mechanicUid == request.auth.uid
            && request.resource.data.mechanicUid == request.auth.uid
            && request.resource.data.status
              in ['accepted', 'onTheWay', 'completed'])
          // Admin oversight (reassign / cancel any request).
          || isAdmin()
        );
      // Driver may permanently remove their own pending/cancelled request
      // (e.g. after the thread cleanup below runs).
      allow delete: if signedIn()
        && resource.data.driverUid == request.auth.uid
        && resource.data.status in ['pending', 'cancelled'];
      allow delete: if isAdmin();

      // Per-request chat. Only the driver and the assigned mechanic
      // of the parent request may read; each writes as themselves.
      match /messages/{messageId} {
        function isParty() {
          return request.auth != null && (
            get(/databases/$(database)/documents/requests/$(requestId)).data.driverUid == request.auth.uid ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.mechanicUid == request.auth.uid
          );
        }
        allow read: if isParty() || isAdmin();
        allow create: if isParty()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        // Sender may edit text of their own message.
        allow update: if (isParty()
          && resource.data.senderUid == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000)
          || isAdmin();
        // Sender may delete their own message; either party may clean
        // up a thread whose parent request doc is gone.
        allow delete: if (isParty()
          && resource.data.senderUid == request.auth.uid)
          || ((isParty() || isAdmin())
            && !exists(/databases/$(database)/documents/requests/$(requestId)))
          || isAdmin();
      }
    }
  }
}
